{
  "name": "swiftsftp-explorer",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "SwiftSFTP Explorer - A fast, native SFTP file manager for Windows",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
